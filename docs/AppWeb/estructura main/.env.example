# Archivo de Ejemplo de Variables de Entorno
# Copiar este archivo como .env y completar con tus valores

# =====================================================
# Base de Datos
# =====================================================
DB_HOST=localhost
DB_NAME=movilidad_cdmx
DB_USER=movilidad_user
DB_PASS=tu_contraseña_segura_aqui

# =====================================================
# APIs Externas
# =====================================================
GOOGLE_MAPS_API_KEY=AIzaSyD_tu_clave_aqui
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# =====================================================
# Configuración de la Aplicación
# =====================================================
ENVIRONMENT=development
# development - Muestra errores, permite debug
# production - Oculta errores, desactiva debug

BASE_URL=http://localhost/movilidad-cdmx/
APP_NAME=Movilidad CDMX
APP_VERSION=1.0.0

# =====================================================
# Seguridad
# =====================================================
JWT_SECRET=tu_secreto_super_seguro_aqui_cambiar_en_produccion
SESSION_TIMEOUT=3600
PASSWORD_MIN_LENGTH=8

# =====================================================
# CORS (Si es necesario)
# =====================================================
ALLOWED_ORIGINS=http://localhost,http://localhost:8000

# =====================================================
# Logging
# =====================================================
LOG_LEVEL=info
# debug|info|warning|error|critical

# =====================================================
# Caché
# =====================================================
ENABLE_CACHE=true
CACHE_TIMEOUT=3600

# =====================================================
# Email (Para futuras notificaciones)
# =====================================================
MAIL_FROM=noreply@movilidad-cdmx.app
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=tu_usuario
MAIL_PASSWORD=tu_contraseña

# =====================================================
# Directorio de Uploads
# =====================================================
UPLOAD_DIR=uploads/
MAX_UPLOAD_SIZE=5242880  # 5MB en bytes

# =====================================================
# Configuración de Desarrollo
# =====================================================
DEBUG=false
SHOW_ERRORS=false
PROFILING_ENABLED=false
